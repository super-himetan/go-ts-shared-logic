{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "contentMappers": [{ "package": "go-mapper", "extensions": [".go"] }],
  "include": ["web", "tests/*.ts"]
}
